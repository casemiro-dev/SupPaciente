# >>> CONFIGURAÇÕES SENSÍVEIS (senhas, firebaseConfig) <<<
config.local.js
config.*.local.js
.env
.env.*
*.secret.js
secrets/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Node (caso evolua para build)
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*

# Backups
*.bak
*.orig
*~
